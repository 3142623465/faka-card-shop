# ============================================
# 发卡网系统 · 环境变量配置（本文件已被 .gitignore 排除，不会随代码分发）
# 复制为 .env 并按需填写；服务启动时自动加载（server.js 内置零依赖加载器）
# ============================================

# ---- 服务端口 ----
PORT=3000

# ---- 数据库：留空使用本地 JSON 文件；云部署填 MongoDB 连接串 ----
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/card-shop

# ---- 邮件服务（QQ 邮箱发信，用于注册/找回密码验证码）----
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=3099960285@qq.com
SMTP_PASS=
SMTP_FROM=3099960285@qq.com

# ---- 运行模式 ----
# NODE_ENV=production        # 生产模式（阻断验证码 devCode 直显）
# ALLOW_DEVCODE=1            # 仅内部调试：生产模式下显式放行 devCode（用完必须关闭）
